// Hospital Management System - ERD (Phase 2 final)

Enum sex_choices {
  male
  female
}

Enum role_choices {
  doctor
  nurse
  pharmacist
  receptionist
  cashier
  admin
}

Enum appointment_status_choices {
  scheduled
  confirmed
  checked_in
  in_progress
  completed
  cancelled
  no_show
}

Enum payment_method_choices {
  cash
  transfer
  pos
}

// Django's login table (AbstractUser)
Table User {
  id integer [pk, increment]
  username varchar [unique, not null]
  password varchar [not null]
  email varchar
  first_name varchar
  last_name varchar
  is_active boolean [not null, default: true, note: 'Can this login sign in?']
  date_joined timestamp [not null, note: 'When the login account was created']
}

Table staff {
  id integer [pk, increment]
  user_id integer [unique, not null, ref: - User.id, note: 'Every staff member has a login']
  role role_choices [not null]
  phone varchar
}

Table patients {
  id integer [pk, increment]
  user_id integer [unique, ref: - User.id, note: 'Optional: only if the patient signs up for the portal']
  mrn varchar [unique, not null, note: 'Number on hospital card']
  surname varchar [not null]
  first_name varchar [not null]
  date_of_birth date [not null]
  sex sex_choices [not null]
  phone varchar
  address varchar
  is_active boolean [not null, default: true, note: 'Is this patient record active?']
  created_at timestamp [not null, default: `now()`, note: 'Date registered at the hospital']
}

Table appointments {
  id integer [pk, increment]
  patient_id integer [not null, ref: > patients.id]
  doctor_id integer [not null, ref: > staff.id, note: 'Staff with role = doctor']
  scheduled_at timestamp [not null]
  status appointment_status_choices [not null, default: 'scheduled']
  reason text
  created_at timestamp [not null, default: `now()`]
}

Table visits {
  id integer [pk, increment]
  patient_id integer [not null, ref: > patients.id]
  doctor_id integer [not null, ref: > staff.id, note: 'Staff with role = doctor']
  appointment_id integer [unique, ref: - appointments.id, note: 'Empty for walk-ins']
  visit_at timestamp [not null]
  reason text [not null]
  note text
  diagnosis text
}

Table drugs {
  id integer [pk, increment]
  name varchar [unique, not null]
}

Table prescriptions {
  id integer [pk, increment]
  visit_id integer [not null, ref: > visits.id]
  drug_id integer [not null, ref: > drugs.id]
  dose varchar [not null]
  frequency varchar [not null]
  duration varchar
  instruction text
}

Table invoices {
  id integer [pk, increment]
  visit_id integer [unique, not null, ref: - visits.id, note: 'One invoice per visit']
  invoice_no varchar [unique, not null]
  amount decimal(12,2) [not null, note: 'More than 0']
  created_at timestamp [not null, default: `now()`]
}

Table payments {
  id integer [pk, increment]
  invoice_id integer [not null, ref: > invoices.id]
  amount decimal(12,2) [not null, note: 'More than 0. Payments on an invoice never add up to more than the invoice']
  method payment_method_choices [not null]
  reference varchar
  paid_at timestamp [not null]
}